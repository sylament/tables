{% set records = component.getRecords %}
{% set columns = component.getColumns %}
{% set hostId = component.getLiveComponent.getTableHostId %}

{% set paginator = component.getPaginator %}
{% set footerVisible = paginator and (paginator.getTotalRecordCount is null
    ? (paginator.count > 0 or not paginator.onFirstPage or paginator.hasMorePages)
    : paginator.getTotalRecordCount > 0) %}
{% set sortColumn = component.getSortColumn %}
{% set sortDirection = component.getSortDirection %}
{% set isSearchable = component.isSearchable %}
{% set isFilterable = component.isFilterable %}
{% set filtersTriggerVisible = isFilterable and component.hasFiltersDropdown %}
{% set filterIndicators = component.getFilterIndicators %}
{% set removableIndicatorCount = filterIndicators|filter(carrier => carrier.indicator.isRemovable)|length %}

{% set headerActions = component.getHeaderActions|filter(action => action.isVisible) %}
{% set toolbarActions = component.getToolbarActions|filter(action => action.isVisible) %}
{% set heading = component.getHeading %}
{% set description = component.getDescription %}
{% set headingTag = component.getHeadingTag %}
{% set headerVisible = heading or description or headerActions is not empty %}
{% set headerActionsAdaptive = component.getHeaderActionsPosition is same as(constant('Sylament\\Tables\\Enums\\HeaderActionsPosition::Adaptive')) %}
{% set toolbarVisible = isSearchable or filtersTriggerVisible or toolbarActions is not empty %}

{% set recordActionsByKey = component.getVisibleRecordActionsByRecordKey %}
{% set hasRecordActions = recordActionsByKey|filter(actions => actions is not empty)|length > 0 %}
{% set recordActionsPosition = component.getRecordActionsPosition.name %}
{% set actionsBeforeCells = hasRecordActions and recordActionsPosition == 'BeforeCells' %}
{% set actionsBeforeColumns = hasRecordActions and recordActionsPosition == 'BeforeColumns' %}
{% set actionsAfterColumns = hasRecordActions and recordActionsPosition == 'AfterColumns' %}
{% set actionsAfterCells = hasRecordActions and recordActionsPosition == 'AfterCells' %}

{% set isSelectionEnabled = component.isSelectionEnabled %}
{% set hasSelection = isSelectionEnabled and component.getLiveComponent.hasSelectedTableRecords %}
{% set checkboxLeading = isSelectionEnabled and component.getRecordCheckboxPosition.name == 'BeforeCells' %}
{% set checkboxTrailing = isSelectionEnabled and component.getRecordCheckboxPosition.name == 'AfterCells' %}
{% set allSelectableCount = isSelectionEnabled ? component.getLiveComponent.getAllSelectableTableRecordsCount : null %}

{% set emptyStateIcon = component.getEmptyStateIcon %}
{% set emptyStateDescription = component.getEmptyStateDescription %}

<div {{ attrs({
    class: 'sy sy-ta',
}, isSelectionEnabled ? stimulus_controller('sylament--tables--table', {
    canTrack: component.canTrackDeselectedRecords,
    pageOnly: component.selectsCurrentPageOnly,
    allSelectableCount: allSelectableCount,
    countOne: '1 record selected',
    countMany: ':count records selected',
}) : null) }}>
    <div class="sy-ta-ctn">
        {% if headerVisible %}
            <div {{ attrs({class: classes('sy-ta-header', {'sy-ta-header-adaptive-actions-position': headerActions is not empty and headerActionsAdaptive})}) }}>
                {% if heading or description %}
                    <div>
                        {% if heading %}
                            <{{ headingTag }} class="sy-ta-header-heading">{{ heading }}</{{ headingTag }}>
                        {% endif %}

                        {% if description %}
                            <p class="sy-ta-header-description">{{ description }}</p>
                        {% endif %}
                    </div>
                {% endif %}

                {% if headerActions is not empty %}
                    <div class="sy-ta-header-actions">
                        {% for action in headerActions %}
                            {% set isBulkOnly = action.isBulk is defined
                                ? action.isBulk
                                : (action.getExtraDropdownAttributes['data-sy-table-bulk-only'] ?? false) %}

                            {% if isBulkOnly %}
                                <span {{ attrs({
                                    'data-sy-table-bulk-only': true,
                                    hidden: not hasSelection,
                                }) }}>{{ renderComponent(action) }}</span>
                            {% else %}
                                {{ renderComponent(action) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if toolbarVisible %}
            <div class="sy-ta-header-toolbar">
                {% if toolbarActions is not empty %}
                    <div class="sy-ta-header-toolbar-actions">
                        {# reorder trigger slot — M4 · 3 #}

                        {% for action in toolbarActions %}
                            {% set isBulkOnly = action.isBulk is defined
                                ? action.isBulk
                                : (action.getExtraDropdownAttributes['data-sy-table-bulk-only'] ?? false) %}

                            {% if isBulkOnly %}
                                <span {{ attrs({
                                    'data-sy-table-bulk-only': true,
                                    hidden: not hasSelection,
                                }) }}>{{ renderComponent(action) }}</span>
                            {% else %}
                                {{ renderComponent(action) }}
                            {% endif %}
                        {% endfor %}

                        {# grouping selector slot — M4 · 6 #}
                    </div>
                {% endif %}

                <div class="sy-ta-header-toolbar-end">
                    {% if isSearchable %}
                        <label class="sy-ta-search-field">
                            <twig:SylamentSupport:Icon
                                icon="heroicons:magnifying-glass-20-solid"
                                :alias="constant('Sylament\\Tables\\Twig\\TablesIconAlias::SEARCH_FIELD')"
                            />
                            <input
                                type="search"
                                class="sy-ta-search-input"
                                autocomplete="off"
                                maxlength="1000"
                                placeholder="{{ component.getSearchPlaceholder ?? 'Search' }}"
                                aria-label="Search"
                                data-model="{{ component.isSearchOnBlur ? 'on(change)|tableSearch' : 'debounce(' ~ component.getSearchDebounceMilliseconds ~ ')|tableSearch' }}"
                            >
                        </label>
                    {% endif %}

                    {% if filtersTriggerVisible %}
                        {% set activeFiltersCount = component.getActiveFiltersCount %}
                        {% set filtersApplyVisible = component.hasDeferredFilters %}
                        {% set filtersResetActionPosition = component.getFiltersResetActionPosition %}
                        {% set filtersForm %}{{ renderComponent(component.getLiveComponent.getTableFiltersForm) }}{% endset %}

                        <twig:SylamentSupport:Dropdown
                            class="sy-ta-filters-dropdown"
                            placement="bottom-end"
                            :flip="false"
                            :teleport="true"
                            :width="component.getFiltersFormWidth"
                            :maxHeight="component.getFiltersFormMaxHeight"
                        >
                            <twig:block name="trigger">
                                <span class="sy-ta-filters-trigger">
                                    <twig:SylamentSupport:IconButton
                                        icon="heroicons:funnel-20-solid"
                                        :iconAlias="constant('Sylament\\Tables\\Twig\\TablesIconAlias::ACTIONS_FILTER')"
                                        color="gray"
                                        label="Filter"
                                    />

                                    {% if activeFiltersCount > 0 %}
                                        <span class="sy-ta-filters-trigger-badge-ctn">
                                            <twig:SylamentSupport:Badge class="sy-ta-filters-trigger-badge" size="xs">{{ activeFiltersCount }}</twig:SylamentSupport:Badge>
                                        </span>
                                    {% endif %}
                                </span>
                            </twig:block>

                            <twig:block name="content">
                                <twig:SylamentTables:Filters
                                    :headingLevel="3"
                                    :resetActionPosition="filtersResetActionPosition"
                                    :schema="filtersForm"
                                    :applyVisible="filtersApplyVisible"
                                />
                            </twig:block>
                        </twig:SylamentSupport:Dropdown>
                    {% endif %}

                    {# column manager slot — M4 · 5 #}
                </div>
            </div>
        {% endif %}

        {% if filterIndicators is not empty %}
            {% set removeAllAttributes = stimulus_action('live', 'action', parameters: {action: 'removeTableFilters'}) %}

            <div class="sy-ta-filter-indicators">
                <div class="sy-ta-filter-indicators-ctn">
                    <span class="sy-ta-filter-indicators-label">Active filters</span>

                    <div class="sy-ta-filter-indicators-badges-ctn">
                        {% for carrier in filterIndicators %}
                            {% set indicator = carrier.indicator %}
                            {% set removeAttributes = indicator.isRemovable
                                ? stimulus_action('live', 'action', parameters: {
                                    action: carrier.removeAction,
                                    ...carrier.removeArguments,
                                }|filter(value => value is not null))
                                : {} %}

                            <twig:SylamentSupport:Badge
                                class="sy-ta-filter-indicator"
                                :color="indicator.getColor ?? 'primary'"
                                :deletable="indicator.isRemovable"
                                deleteLabel="Remove filter"
                                :deleteAttributes="removeAttributes"
                            >{{ indicator.getLabel }}</twig:SylamentSupport:Badge>
                        {% endfor %}
                    </div>
                </div>

                {% if removableIndicatorCount > 0 %}
                    <twig:SylamentSupport:IconButton
                        class="sy-ta-filter-indicators-remove-all-btn"
                        icon="heroicons:x-mark-20-solid"
                        :iconAlias="constant('Sylament\\Tables\\Twig\\TablesIconAlias::FILTERS_REMOVE_ALL_BUTTON')"
                        size="sm"
                        color="gray"
                        label="Remove all filters"
                        {{ ...removeAllAttributes }}
                    />
                {% endif %}
            </div>
        {% endif %}

        {% if isSelectionEnabled %}
            <div {{ attrs({
                class: 'sy-ta-selection-indicator',
                role: 'status',
                'aria-live': 'polite',
                'aria-atomic': 'true',
                hidden: not hasSelection,
            }, stimulus_target('sylament--tables--table', 'banner')) }}>
                <div>
                    <span {{ attrs(stimulus_target('sylament--tables--table', 'count')) }}></span>
                </div>

                <div class="sy-ta-selection-indicator-actions-ctn">
                    <twig:SylamentSupport:Link
                        tag="button"
                        color="primary"
                        :hidden="true"
                        {{ ...stimulus_target('sylament--tables--table', 'selectAll') }}
                        {{ ...stimulus_action('sylament--tables--table', 'selectAll', 'click') }}
                    >Select all{{ allSelectableCount is not null ? ' ' ~ allSelectableCount : '' }}</twig:SylamentSupport:Link>

                    <twig:SylamentSupport:Link
                        tag="button"
                        color="danger"
                        {{ ...stimulus_target('sylament--tables--table', 'deselectAll') }}
                        {{ ...stimulus_action('sylament--tables--table', 'deselectAll', 'click') }}
                    >Deselect all</twig:SylamentSupport:Link>
                </div>
            </div>
        {% endif %}

        {% if records is empty %}
            <div class="sy-ta-empty-state" role="status">
                <div class="sy-ta-empty-state-content">
                    <div class="sy-ta-empty-state-icon-bg">
                        <twig:SylamentSupport:Icon
                            :icon="emptyStateIcon ?? 'heroicons:x-mark'"
                            :alias="emptyStateIcon ? null : constant('Sylament\\Tables\\Twig\\TablesIconAlias::EMPTY_STATE')"
                            size="lg"
                        />
                    </div>
                    <h3 class="sy-ta-empty-state-heading">{{ component.getEmptyStateHeading }}</h3>
                    {% if emptyStateDescription %}
                        <p class="sy-ta-empty-state-description">{{ emptyStateDescription }}</p>
                    {% endif %}
                </div>
            </div>
        {% else %}
            {% set actionsHeaderCell %}<th scope="col" aria-label="Actions" class="sy-ta-actions-header-cell sy-ta-empty-header-cell"></th>{% endset %}

            {% set selectionHeaderCell %}
                <th scope="col" class="sy-ta-selection-cell">
                    <input {{ attrs({
                        type: 'checkbox',
                        class: 'sy-checkbox sy-ta-page-checkbox',
                        'aria-label': 'Select/deselect all records on this page for bulk actions.',
                    }, stimulus_target('sylament--tables--table', 'pageCheckbox'), stimulus_action('sylament--tables--table', 'togglePage', 'change')) }}>
                </th>
            {% endset %}

            <table class="sy-ta-table">
                <thead>
                    <tr>
                        {% if actionsBeforeCells %}{{ actionsHeaderCell }}{% endif %}
                        {% if checkboxLeading %}{{ selectionHeaderCell }}{% endif %}
                        {% if actionsBeforeColumns %}{{ actionsHeaderCell }}{% endif %}
                        {% for column in columns %}
                            {% set columnName = column.getName %}
                            {% set isColumnSortable = column.isSortable %}
                            {% set isColumnSorted = isColumnSortable and sortColumn == columnName %}
                            <th
                                scope="col"
                                {{ attrs({
                                    class: classes('sy-ta-header-cell', {'sy-ta-header-cell-sorted': isColumnSorted}),
                                    'aria-sort': isColumnSortable ? (isColumnSorted ? (sortDirection == 'desc' ? 'descending' : 'ascending') : 'none') : null,
                                }) }}
                            >
                                {% if isColumnSortable %}
                                    <button
                                        type="button"
                                        class="sy-ta-header-cell-sort-btn"
                                        {{ stimulus_action('live', 'action', parameters: {action: 'sortTable', column: columnName}) }}
                                    >
                                        {{ column.getLabel }}
                                        <twig:SylamentSupport:Icon
                                            :icon="isColumnSorted and sortDirection == 'asc' ? 'heroicons:chevron-up-20-solid' : 'heroicons:chevron-down-20-solid'"
                                            :alias="isColumnSorted
                                                ? (sortDirection == 'asc'
                                                    ? constant('Sylament\\Tables\\Twig\\TablesIconAlias::HEADER_CELL_SORT_ASC_BUTTON')
                                                    : constant('Sylament\\Tables\\Twig\\TablesIconAlias::HEADER_CELL_SORT_DESC_BUTTON'))
                                                : constant('Sylament\\Tables\\Twig\\TablesIconAlias::HEADER_CELL_SORT_BUTTON')"
                                        />
                                    </button>
                                {% else %}
                                    {{ column.getLabel }}
                                {% endif %}
                            </th>
                        {% endfor %}
                        {% if actionsAfterColumns %}{{ actionsHeaderCell }}{% endif %}
                        {% if checkboxTrailing %}{{ selectionHeaderCell }}{% endif %}
                        {% if actionsAfterCells %}{{ actionsHeaderCell }}{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for recordKey, record in records %}
                        {% set actionsCell %}{% if hasRecordActions %}
                            <td class="sy-ta-cell">
                                <div class="sy-ta-actions">
                                    {% for action in recordActionsByKey[recordKey] ?? [] %}
                                        {{ renderComponent(action) }}
                                    {% endfor %}
                                </div>
                            </td>
                        {% endif %}{% endset %}

                        {% set selectionCell %}{% if isSelectionEnabled %}
                            <td class="sy-ta-cell sy-ta-selection-cell">
                                {% if component.isRecordSelectable(record) %}
                                    <input {{ attrs({
                                        type: 'checkbox',
                                        class: 'sy-checkbox sy-ta-record-checkbox',
                                        value: recordKey,
                                        checked: component.getLiveComponent.isTableRecordSelected(recordKey),
                                        'aria-label': 'Select/deselect record ' ~ recordKey ~ ' for bulk actions.',
                                    }, stimulus_target('sylament--tables--table', 'recordCheckbox'), stimulus_action('sylament--tables--table', 'toggleRecord', 'change')) }}>
                                {% endif %}
                            </td>
                        {% endif %}{% endset %}

                        <tr class="sy-ta-row" id="{{ hostId ~ '.table.records.' ~ recordKey }}">
                            {% if actionsBeforeCells %}{{ actionsCell }}{% endif %}
                            {% if checkboxLeading %}{{ selectionCell }}{% endif %}
                            {% if actionsBeforeColumns %}{{ actionsCell }}{% endif %}
                            {% for column in columns %}
                                {% do column.record(record) %}
                                {% do column.recordKey(recordKey) %}
                                <td class="sy-ta-cell" id="{{ hostId ~ '.table.record.' ~ recordKey ~ '.column.' ~ column.getName }}">
                                    <div class="sy-ta-col">{{ renderComponent(column) }}</div>
                                </td>
                            {% endfor %}
                            {% if actionsAfterColumns %}{{ actionsCell }}{% endif %}
                            {% if checkboxTrailing %}{{ selectionCell }}{% endif %}
                            {% if actionsAfterCells %}{{ actionsCell }}{% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if footerVisible %}
            <twig:SylamentSupport:Pagination
                :paginator="paginator"
                :pageOptions="component.getPaginationPageOptions"
                :extremeLinks="component.hasExtremePaginationLinks"
                :currentPerPage="component.getLiveComponent.getTableRecordsPerPage"
            />
        {% endif %}
    </div>
</div>
