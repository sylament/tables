{# Null until the deferred window closes, so every records-touching read below
   stays gated on it — an ungated one queries a table that renders no rows. #}
{% set records = component.isLoaded ? component.getRecords : null %}
{% set columns = component.getColumns %}
{% set hostId = component.getLiveComponent.getTableHostId %}
{% set isReorderable = component.isReorderable %}
{% set isReordering = component.isReordering %}
{% set isDeferred = component.isLoadingDeferred %}
{% set pollIntervalMilliseconds = isReordering ? null : component.getPollingIntervalMilliseconds %}

{% set paginator = records is not null ? component.getPaginator : null %}
{% set footerVisible = paginator and (paginator.getTotalRecordCount is null
    ? (paginator.count > 0 or not paginator.onFirstPage or paginator.hasMorePages)
    : paginator.getTotalRecordCount > 0) %}
{% set sortColumn = component.getSortColumn %}
{% set sortDirection = component.getSortDirection %}
{% set isSearchable = component.isSearchable %}
{% set isFilterable = component.isFilterable %}
{% set filtersTriggerVisible = isFilterable and component.hasFiltersTrigger %}
{% set filtersDropdownVisible = isFilterable and component.hasFiltersDropdown %}
{% set filtersModalVisible = isFilterable and component.hasFiltersModal %}
{% set filtersAboveContent = isFilterable and component.hasFiltersAboveContent %}
{% set filtersBelowContent = isFilterable and component.hasFiltersBelowContent %}
{% set filtersCollapsible = isFilterable and component.hasCollapsibleFilters %}
{% set filtersPanelVisible = filtersDropdownVisible or filtersAboveContent or filtersBelowContent %}
{% set filtersChromeVisible = filtersPanelVisible or filtersModalVisible %}
{% set activeFiltersCount = isFilterable ? component.getActiveFiltersCount : 0 %}
{% set filtersApplyAction = filtersChromeVisible ? component.getFiltersApplyAction : null %}
{% set filtersApplyVisible = filtersApplyAction is not null and filtersApplyAction.isVisible %}
{% set filtersResetActionPosition = isFilterable ? component.getFiltersResetActionPosition : null %}
{% set filtersForm = filtersChromeVisible ? renderComponent(component.getLiveComponent.getTableFiltersForm) : null %}

{% set filterIndicators = component.getFilterIndicators %}
{% set removableIndicatorCount = filterIndicators|filter(carrier => carrier.indicator.isRemovable)|length %}

{% set headerActions = isReordering ? [] : component.getHeaderActions|filter(action => action.isVisible) %}
{% set toolbarActions = isReordering ? [] : component.getToolbarActions|filter(action => action.isVisible) %}
{% set heading = component.getHeading %}
{% set description = component.getDescription %}
{% set headingTag = component.getHeadingTag %}
{% set headerVisible = heading or description or headerActions is not empty %}
{% set headerActionsAdaptive = component.getHeaderActionsPosition is same as(constant('Sylament\\Tables\\Enums\\HeaderActionsPosition::Adaptive')) %}
{% set toolbarVisible = isSearchable or filtersTriggerVisible or toolbarActions is not empty or isReorderable %}

{% set recordActionsByKey = isReordering or records is null ? {} : component.getVisibleRecordActionsByRecordKey %}
{% set hasRecordActions = recordActionsByKey|filter(actions => actions is not empty)|length > 0 %}
{% set recordActionsPosition = component.getRecordActionsPosition.name %}
{% set actionsBeforeCells = hasRecordActions and recordActionsPosition == 'BeforeCells' %}
{% set actionsBeforeColumns = hasRecordActions and recordActionsPosition == 'BeforeColumns' %}
{% set actionsAfterColumns = hasRecordActions and recordActionsPosition == 'AfterColumns' %}
{% set actionsAfterCells = hasRecordActions and recordActionsPosition == 'AfterCells' %}

{% set isSelectionEnabled = component.isSelectionEnabled %}
{% set hasSelection = isSelectionEnabled and component.getLiveComponent.hasSelectedTableRecords %}
{% set checkboxLeading = isSelectionEnabled and not isReordering and component.getRecordCheckboxPosition.name == 'BeforeCells' %}
{% set checkboxTrailing = isSelectionEnabled and not isReordering and component.getRecordCheckboxPosition.name == 'AfterCells' %}
{% set allSelectableCount = isSelectionEnabled and not isReordering and records is not null ? component.getLiveComponent.getAllSelectableTableRecordsCount : null %}

{% set isStriped = component.isStriped %}

{% set emptyState = component.getEmptyState %}
{% set emptyStateIcon = component.getEmptyStateIcon %}
{% set emptyStateHeadingTag = heading ? component.getHeadingTag(1) : headingTag %}
{% set emptyStateDescription = component.getEmptyStateDescription %}
{% set emptyStateActions = component.getEmptyStateActions|filter(action => action.isVisible) %}

{% set filtersCountBadge %}
    {%- if activeFiltersCount > 0 -%}
        <span class="sy-ta-filters-trigger-badge-ctn">
            <twig:SylamentSupport:Badge class="sy-ta-filters-trigger-badge" size="xs">{{ activeFiltersCount }}</twig:SylamentSupport:Badge>
        </span>
    {%- endif -%}
{% endset %}

{% set filtersTriggerControl = null %}
{% if filtersTriggerVisible %}
    {% set filtersTriggerControl %}
        <span class="sy-ta-filters-trigger">{{ renderComponent(component.getFiltersTriggerAction) }}{{ filtersCountBadge }}</span>
    {% endset %}
{% endif %}

{% set filtersPanel = null %}
{% if filtersPanelVisible %}
    {% set filtersPanel %}
        <twig:SylamentTables:Filters
            :headingLevel="3"
            :resetActionPosition="filtersResetActionPosition"
            :schema="filtersForm"
            :applyVisible="filtersApplyVisible"
            :applyAction="filtersApplyAction"
        />
    {% endset %}
{% endif %}

<div {{ attrs({
    class: 'sy sy-ta',
}, isSelectionEnabled or isReorderable or isDeferred or pollIntervalMilliseconds is not null ? stimulus_controller('sylament--tables--table', {
    canTrack: component.canTrackDeselectedRecords,
    pageOnly: component.selectsCurrentPageOnly,
    allSelectableCount: allSelectableCount,
    deferred: isDeferred,
    pollInterval: pollIntervalMilliseconds,
    countOne: '1 record selected',
    countMany: ':count records selected',
}) : null) }}>
    <div class="sy-ta-ctn">
        {% if headerVisible %}
            <div {{ attrs({class: classes('sy-ta-header', {'sy-ta-header-adaptive-actions-position': headerActions is not empty and headerActionsAdaptive})}) }}>
                {% if heading or description %}
                    <div>
                        {% if heading %}
                            <{{ headingTag }} class="sy-ta-header-heading">{{ heading }}</{{ headingTag }}>
                        {% endif %}

                        {% if description %}
                            <p class="sy-ta-header-description">{{ description }}</p>
                        {% endif %}
                    </div>
                {% endif %}

                {% if headerActions is not empty %}
                    <div class="sy-ta-header-actions">
                        {% for action in headerActions %}
                            {% set isBulkOnly = action.isBulk is defined
                                ? action.isBulk
                                : (action.getExtraDropdownAttributes['data-sy-table-bulk-only'] ?? false) %}

                            {% if isBulkOnly %}
                                <span {{ attrs({
                                    'data-sy-table-bulk-only': true,
                                    hidden: not hasSelection,
                                }) }}>{{ renderComponent(action) }}</span>
                            {% else %}
                                {{ renderComponent(action) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if toolbarVisible %}
            <div class="sy-ta-header-toolbar">
                {% if isReorderable or toolbarActions is not empty %}
                    <div class="sy-ta-header-toolbar-actions">
                        {% if isReorderable %}
                            {{ renderComponent(component.getReorderRecordsTriggerAction(isReordering)) }}
                        {% endif %}

                        {% for action in toolbarActions %}
                            {% set isBulkOnly = action.isBulk is defined
                                ? action.isBulk
                                : (action.getExtraDropdownAttributes['data-sy-table-bulk-only'] ?? false) %}

                            {% if isBulkOnly %}
                                <span {{ attrs({
                                    'data-sy-table-bulk-only': true,
                                    hidden: not hasSelection,
                                }) }}>{{ renderComponent(action) }}</span>
                            {% else %}
                                {{ renderComponent(action) }}
                            {% endif %}
                        {% endfor %}

                        {# grouping selector slot — M4 · 6 #}
                    </div>
                {% endif %}

                <div class="sy-ta-header-toolbar-end">
                    {% if isSearchable %}
                        <label class="sy-ta-search-field">
                            <twig:SylamentSupport:Icon
                                icon="heroicons:magnifying-glass-20-solid"
                                :alias="constant('Sylament\\Tables\\Twig\\TablesIconAlias::SEARCH_FIELD')"
                            />
                            <input
                                type="search"
                                class="sy-ta-search-input"
                                autocomplete="off"
                                maxlength="1000"
                                placeholder="{{ component.getSearchPlaceholder ?? 'Search' }}"
                                aria-label="Search"
                                data-model="{{ component.isSearchOnBlur ? 'on(change)|tableSearch' : 'debounce(' ~ component.getSearchDebounceMilliseconds ~ ')|tableSearch' }}"
                            >
                        </label>
                    {% endif %}

                    {% if filtersDropdownVisible %}
                        <twig:SylamentSupport:Dropdown
                            class="sy-ta-filters-dropdown"
                            placement="bottom-end"
                            :flip="false"
                            :teleport="true"
                            :width="component.getFiltersFormWidth"
                            :maxHeight="component.getFiltersFormMaxHeight"
                        >
                            <twig:block name="trigger">{{ filtersTriggerControl }}</twig:block>

                            <twig:block name="content">{{ filtersPanel }}</twig:block>
                        </twig:SylamentSupport:Dropdown>
                    {% elseif filtersModalVisible %}
                        {{ filtersTriggerControl }}
                    {% endif %}

                    {# column manager slot — M4 · 5 #}
                </div>
            </div>
        {% endif %}

        {% if filtersModalVisible %}
            {% set filtersResetAttributes = stimulus_action('live', 'action', parameters: {action: 'resetTableFiltersForm'}) %}

            <twig:SylamentSupport:Modal
                :id="component.getFiltersModalId"
                heading="Filters"
                :width="component.getFiltersFormWidth ?? 'md'"
            >
                <twig:block name="content">{{ filtersForm }}</twig:block>

                <twig:block name="footer">
                    <div class="sy-modal-footer-actions">
                        {% if filtersApplyVisible %}
                            {{ renderComponent(filtersApplyAction) }}
                        {% endif %}

                        <twig:SylamentSupport:Button color="danger" size="sm" {{ ...filtersResetAttributes }}>Reset</twig:SylamentSupport:Button>
                    </div>
                </twig:block>
            </twig:SylamentSupport:Modal>
        {% endif %}

        {% if filterIndicators is not empty %}
            <div class="sy-ta-filter-indicators">
                <div class="sy-ta-filter-indicators-ctn">
                    <span class="sy-ta-filter-indicators-label">Active filters</span>

                    <div class="sy-ta-filter-indicators-badges-ctn">
                        {% for carrier in filterIndicators %}
                            {% set indicator = carrier.indicator %}
                            {% set removeAttributes = indicator.isRemovable
                                ? stimulus_action('live', 'action', parameters: {
                                    action: carrier.removeAction,
                                    ...carrier.removeArguments,
                                }|filter(value => value is not null))
                                : {} %}

                            <twig:SylamentSupport:Badge
                                class="sy-ta-filter-indicator"
                                :color="indicator.getColor ?? 'primary'"
                                :deletable="indicator.isRemovable"
                                deleteLabel="Remove filter"
                                :deleteAttributes="removeAttributes"
                            >{{ indicator.getLabel }}</twig:SylamentSupport:Badge>
                        {% endfor %}
                    </div>
                </div>

                {% if removableIndicatorCount > 0 %}
                    {{ renderComponent(component.getFiltersRemoveAllAction) }}
                {% endif %}
            </div>
        {% endif %}

        {% if filtersAboveContent %}
            {% if filtersCollapsible %}
                <details {{ attrs({class: 'sy-ta-filters-above-content-ctn sy-ta-filters-collapsible', open: activeFiltersCount > 0}) }}>
                    <summary class="sy-ta-filters-summary">
                        <span class="sy-ta-filters-trigger">
                            <twig:SylamentSupport:IconButton
                                tag="span"
                                icon="heroicons:funnel-20-solid"
                                :iconAlias="constant('Sylament\\Tables\\Twig\\TablesIconAlias::ACTIONS_FILTER')"
                                color="gray"
                                label="Filter"
                            />{{ filtersCountBadge }}</span>
                    </summary>

                    {{ filtersPanel }}
                </details>
            {% else %}
                <div class="sy-ta-filters-above-content-ctn">{{ filtersPanel }}</div>
            {% endif %}
        {% endif %}

        {% if isReordering %}
            <div class="sy-ta-reorder-indicator" role="status" aria-live="polite">
                Drag and drop the records into order.
            </div>
        {% elseif isSelectionEnabled and records is not null %}
            <div {{ attrs({
                class: 'sy-ta-selection-indicator',
                role: 'status',
                'aria-live': 'polite',
                'aria-atomic': 'true',
                hidden: not hasSelection,
            }, stimulus_target('sylament--tables--table', 'banner')) }}>
                <div>
                    <span {{ attrs(stimulus_target('sylament--tables--table', 'count')) }}></span>
                </div>

                <div class="sy-ta-selection-indicator-actions-ctn">
                    <twig:SylamentSupport:Link
                        tag="button"
                        color="primary"
                        :hidden="true"
                        {{ ...stimulus_target('sylament--tables--table', 'selectAll') }}
                        {{ ...stimulus_action('sylament--tables--table', 'selectAll', 'click') }}
                    >Select all{{ allSelectableCount is not null ? ' ' ~ allSelectableCount : '' }}</twig:SylamentSupport:Link>

                    <twig:SylamentSupport:Link
                        tag="button"
                        color="danger"
                        {{ ...stimulus_target('sylament--tables--table', 'deselectAll') }}
                        {{ ...stimulus_action('sylament--tables--table', 'deselectAll', 'click') }}
                    >Deselect all</twig:SylamentSupport:Link>
                </div>
            </div>
        {% endif %}

        {% if records is null %}
            <div class="sy-ta-table-loading-ctn" role="status" aria-busy="true">
                <twig:SylamentSupport:LoadingIndicator size="2xl" />

                <span class="sy-ta-sr-only">Loading</span>
            </div>
        {% elseif records is empty %}
            {% if emptyState %}
                {{ emptyState }}
            {% else %}
                <div class="sy-ta-empty-state" role="status">
                    <div class="sy-ta-empty-state-content">
                        <div class="sy-ta-empty-state-icon-bg">
                            <twig:SylamentSupport:Icon
                                :icon="emptyStateIcon ?? 'heroicons:x-mark'"
                                :alias="emptyStateIcon ? null : constant('Sylament\\Tables\\Twig\\TablesIconAlias::EMPTY_STATE')"
                                size="lg"
                            />
                        </div>
                        <{{ emptyStateHeadingTag }} class="sy-ta-empty-state-heading">{{ component.getEmptyStateHeading }}</{{ emptyStateHeadingTag }}>
                        {% if emptyStateDescription %}
                            <p class="sy-ta-empty-state-description">{{ emptyStateDescription }}</p>
                        {% endif %}

                        {% if emptyStateActions is not empty %}
                            <div class="sy-ta-empty-state-actions">
                                {% for action in emptyStateActions %}
                                    {{ renderComponent(action) }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% else %}
            {% set actionsHeaderCell %}<th scope="col" aria-label="Actions" class="sy-ta-actions-header-cell sy-ta-empty-header-cell"></th>{% endset %}

            {% set selectionHeaderCell %}
                <th scope="col" class="sy-ta-selection-cell">
                    <input {{ attrs({
                        type: 'checkbox',
                        class: 'sy-checkbox sy-ta-page-checkbox',
                        'aria-label': 'Select/deselect all records on this page for bulk actions.',
                    }, stimulus_target('sylament--tables--table', 'pageCheckbox'), stimulus_action('sylament--tables--table', 'togglePage', 'change')) }}>
                </th>
            {% endset %}

            <table {{ attrs({class: classes('sy-ta-table', {'sy-ta-table-reordering': isReordering})}) }}>
                <thead>
                    <tr>
                        {% if isReordering %}<th scope="col" class="sy-ta-reorder-header-cell sy-ta-empty-header-cell"></th>{% endif %}
                        {% if actionsBeforeCells %}{{ actionsHeaderCell }}{% endif %}
                        {% if checkboxLeading %}{{ selectionHeaderCell }}{% endif %}
                        {% if actionsBeforeColumns %}{{ actionsHeaderCell }}{% endif %}
                        {% for column in columns %}
                            {% set columnName = column.getName %}
                            {% set isColumnSortable = column.isSortable and not isReordering %}
                            {% set isColumnSorted = isColumnSortable and sortColumn == columnName %}
                            <th
                                scope="col"
                                {{ attrs({
                                    class: classes('sy-ta-header-cell', {'sy-ta-header-cell-sorted': isColumnSorted}),
                                    'aria-sort': isColumnSortable ? (isColumnSorted ? (sortDirection == 'desc' ? 'descending' : 'ascending') : 'none') : null,
                                }) }}
                            >
                                {% if isColumnSortable %}
                                    <button
                                        type="button"
                                        class="sy-ta-header-cell-sort-btn"
                                        {{ stimulus_action('live', 'action', parameters: {action: 'sortTable', column: columnName}) }}
                                    >
                                        {{ column.getLabel }}
                                        <twig:SylamentSupport:Icon
                                            :icon="isColumnSorted and sortDirection == 'asc' ? 'heroicons:chevron-up-20-solid' : 'heroicons:chevron-down-20-solid'"
                                            :alias="isColumnSorted
                                                ? (sortDirection == 'asc'
                                                    ? constant('Sylament\\Tables\\Twig\\TablesIconAlias::HEADER_CELL_SORT_ASC_BUTTON')
                                                    : constant('Sylament\\Tables\\Twig\\TablesIconAlias::HEADER_CELL_SORT_DESC_BUTTON'))
                                                : constant('Sylament\\Tables\\Twig\\TablesIconAlias::HEADER_CELL_SORT_BUTTON')"
                                        />
                                    </button>
                                {% else %}
                                    {{ column.getLabel }}
                                {% endif %}
                            </th>
                        {% endfor %}
                        {% if actionsAfterColumns %}{{ actionsHeaderCell }}{% endif %}
                        {% if checkboxTrailing %}{{ selectionHeaderCell }}{% endif %}
                        {% if actionsAfterCells %}{{ actionsHeaderCell }}{% endif %}
                    </tr>
                </thead>
                <tbody {{ attrs(isReordering ? stimulus_controller('sylament--support--sortable', {
                    animationDuration: component.getReorderAnimationDuration,
                })|stimulus_action('sylament--tables--table', 'reorder', 'sylament--support--sortable:end') : null) }}>
                    {% for recordKey, record in records %}
                        {% set recordUrl = component.getRecordUrl(record) %}
                        {% set recordAction = component.getRecordAction(record) %}
                        {% set openRecordUrlInNewTab = component.shouldOpenRecordUrlInNewTab(record) %}
                        {% set recordLinkAttributes = recordUrl is not null ? component.getExtraRecordLinkAttributes(record) : {} %}
                        {% set recordIsSelectable = isSelectionEnabled and component.isRecordSelectable(record) %}

                        {% set actionsCell %}{% if hasRecordActions %}
                            <td class="sy-ta-cell">
                                <div class="sy-ta-actions">
                                    {% for action in recordActionsByKey[recordKey] ?? [] %}
                                        {{ renderComponent(action) }}
                                    {% endfor %}
                                </div>
                            </td>
                        {% endif %}{% endset %}

                        {% set selectionCell %}{% if isSelectionEnabled %}
                            <td class="sy-ta-cell sy-ta-selection-cell">
                                {% if recordIsSelectable %}
                                    <input {{ attrs({
                                        type: 'checkbox',
                                        class: 'sy-checkbox sy-ta-record-checkbox',
                                        value: recordKey,
                                        checked: component.getLiveComponent.isTableRecordSelected(recordKey),
                                        'aria-label': 'Select/deselect record ' ~ recordKey ~ ' for bulk actions.',
                                    }, stimulus_target('sylament--tables--table', 'recordCheckbox'), stimulus_action('sylament--tables--table', 'toggleRecord', 'change')) }}>
                                {% endif %}
                            </td>
                        {% endif %}{% endset %}

                        <tr {{ attrs({
                            class: classes('sy-ta-row', {
                                'sy-clickable': recordUrl is not null or recordAction is not null,
                                'sy-striped': isStriped and loop.index0 is odd,
                                'sy-selected': recordIsSelectable and component.getLiveComponent.isTableRecordSelected(recordKey),
                            }, component.getRecordClasses(record)),
                            id: hostId ~ '.table.records.' ~ recordKey,
                            'data-sortable-item': isReordering ? recordKey : null,
                        }) }}>
                            {% if isReordering %}
                                <td class="sy-ta-cell sy-ta-reorder-handle-cell">
                                    <twig:SylamentSupport:IconButton
                                        class="sy-ta-reorder-handle"
                                        icon="heroicons:bars-2"
                                        :iconAlias="constant('Sylament\\Tables\\Twig\\TablesIconAlias::REORDER_HANDLE')"
                                        color="gray"
                                        :label="'Reorder item ' ~ recordKey"
                                        :data-sortable-handle="true"
                                    />
                                </td>
                            {% endif %}
                            {% if actionsBeforeCells %}{{ actionsCell }}{% endif %}
                            {% if checkboxLeading %}{{ selectionCell }}{% endif %}
                            {% if actionsBeforeColumns %}{{ actionsCell }}{% endif %}
                            {% for column in columns %}
                                {% do column.record(record) %}
                                {% do column.recordKey(recordKey) %}

                                {# Column-level url/action arms slot in above the record-level ones — M4 · 4 #}
                                {% set cellWrapperTag = isReordering
                                    ? 'div'
                                    : (recordUrl is not null
                                        ? 'a'
                                        : (recordAction is not null ? 'button' : 'div')) %}
                                {% set cellWrapperAttributes = cellWrapperTag == 'a'
                                    ? {
                                        ...recordLinkAttributes,
                                        href: recordUrl,
                                        ...(openRecordUrlInNewTab ? {target: '_blank'} : {}),
                                    }
                                    : (cellWrapperTag == 'button'
                                        ? {
                                            type: 'button',
                                            'data-loading': 'addAttribute(disabled)',
                                            ...stimulus_action('live', 'action', parameters: component.getAction(recordAction)
                                                ? {action: 'mountAction', name: recordAction, context: {recordKey: recordKey ~ '', table: true}}
                                                : {action: recordAction, recordKey: recordKey ~ ''}),
                                        }
                                        : {}) %}

                                <td class="sy-ta-cell" id="{{ hostId ~ '.table.record.' ~ recordKey ~ '.column.' ~ column.getName }}">
                                    <{{ cellWrapperTag }} {{ attrs({class: 'sy-ta-col'}, cellWrapperAttributes) }}>{{ renderComponent(column) }}</{{ cellWrapperTag }}>
                                </td>
                            {% endfor %}
                            {% if actionsAfterColumns %}{{ actionsCell }}{% endif %}
                            {% if checkboxTrailing %}{{ selectionCell }}{% endif %}
                            {% if actionsAfterCells %}{{ actionsCell }}{% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if filtersBelowContent %}
            <div class="sy-ta-filters-below-content-ctn">{{ filtersPanel }}</div>
        {% endif %}

        {% if footerVisible %}
            <twig:SylamentSupport:Pagination
                :paginator="paginator"
                :pageOptions="component.getPaginationPageOptions"
                :extremeLinks="component.hasExtremePaginationLinks"
                :currentPerPage="component.getLiveComponent.getTableRecordsPerPage"
            />
        {% endif %}
    </div>
</div>
