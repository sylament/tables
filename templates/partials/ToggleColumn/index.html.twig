{% set state = component.getClientState %}
{% set error = component.getUpdateStateError %}
{% set isDisabled = component.isDisabled %}
{% set tooltip = component.getTooltip(component.getState) %}
{% set label = component.getLabel %}
{% set ariaLabel = (label is markup ? label|striptags : label)|trim ?: null %}

{% set offColorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\ToggleComponent', component.getOffColor ?? 'gray') %}
{% set onColorAttrs = colorAttributes('Sylament\\Support\\Colors\\Components\\ToggleComponent', component.getOnColor ?? 'primary') %}

<div {{ attrs({
    class: [
        'sy',
        'sy-ta-toggle',
        component.getAlignmentClass,
        component.isInline ? 'sy-inline' : null,
    ],
    title: (tooltip is markup ? tooltip|striptags : tooltip) ?: null,
}, component.getExtraAttributes, stimulus_controller('sylament--tables--editable-cell', {
    column: component.getName,
    record: component.getRecordKey ?? '',
    state: state,
})) }}>
    <label {{ attrs({
        class: ['sy-fo-toggle', offColorAttrs.class],
        style: offColorAttrs.style,
    }) }}>
        <input {{ attrs({
            type: 'checkbox',
            role: 'switch',
            class: 'sy-fo-toggle-input',
            'aria-label': ariaLabel,
            'aria-invalid': error is not null ? true : null,
            checked: state == '1',
            disabled: isDisabled,
        }, stimulus_action('sylament--tables--editable-cell', 'commit', 'change')) }}>

        <span {{ attrs({
            class: ['sy-fo-toggle-track', onColorAttrs.class],
            style: onColorAttrs.style,
        }) }}>
            <span class="sy-fo-toggle-thumb">
                {% if component.hasOffIcon %}
                    <span class="sy-fo-toggle-icon-off"><twig:SylamentSupport:Icon :icon="component.getOffIcon" size="xs" /></span>
                {% endif %}

                {% if component.hasOnIcon %}
                    <span class="sy-fo-toggle-icon-on"><twig:SylamentSupport:Icon :icon="component.getOnIcon" size="xs" /></span>
                {% endif %}
            </span>
        </span>
    </label>

    {% if error is not null %}
        <p class="sy-ta-cell-error">{{ error.message }}</p>
    {% endif %}
</div>
