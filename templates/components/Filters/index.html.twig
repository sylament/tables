{% props
    headingLevel = 3,
    resetActionPosition = null,

    schema = null,

    applyVisible = false
%}

{% set headingTag = 'h' ~ headingLevel %}
{% set resetInFooter = resetActionPosition is not null and resetActionPosition.name == 'Footer' %}
{% set footerVisible = applyVisible or resetInFooter %}
{% set resetAttributes = stimulus_action('live', 'action', parameters: {action: 'resetTableFiltersForm'}) %}
{% set applyAttributes = stimulus_action('live', 'action', parameters: {action: 'applyTableFilters'}) %}

<div {{ attributes.defaults({class: classes('sy sy-ta-filters')}) }}>
    <div class="sy-ta-filters-header">
        <{{ headingTag }} class="sy-ta-filters-heading">Filters</{{ headingTag }}>

        {% if not resetInFooter %}
            <div class="sy-ta-filters-header-actions">
                <twig:SylamentSupport:Link
                    tag="button"
                    color="danger"
                    size="sm"
                    {{ ...resetAttributes }}
                >Reset</twig:SylamentSupport:Link>
            </div>
        {% endif %}
    </div>

    {{ schema }}

    {% if footerVisible %}
        <div class="sy-ta-filters-actions-ctn">
            {% if applyVisible %}
                <twig:SylamentSupport:Button size="sm" {{ ...applyAttributes }}>Apply filters</twig:SylamentSupport:Button>
            {% endif %}

            {% if resetInFooter %}
                <twig:SylamentSupport:Button color="danger" size="sm" {{ ...resetAttributes }}>Reset</twig:SylamentSupport:Button>
            {% endif %}
        </div>
    {% endif %}
</div>
