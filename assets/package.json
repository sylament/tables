{
  "name": "@sylament/tables",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js",
    "build:js": "node scripts/build-js.mjs",
    "watch": "node scripts/build-js.mjs --watch",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "column-manager": {
        "main": "dist/controllers/column_manager_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "editable-cell": {
        "main": "dist/controllers/editable_cell_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "limited-list": {
        "main": "dist/controllers/limited_list_controller.js",
        "fetch": "eager",
        "enabled": true
      },
      "table": {
        "main": "dist/controllers/table_controller.js",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@symfony/ux-live-component": "^3.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
