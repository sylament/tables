{
    "name": "sylament/tables",
    "description": "Sylament tables — datatable builder for the Sylament UI toolkit",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux"
    ],
    "authors": [
        {
            "name": "Martin Petricko",
            "email": "matopetricko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "doctrine/orm": "^3.6",
        "sylament/actions": "self.version",
        "sylament/forms": "self.version",
        "sylament/schemas": "self.version",
        "sylament/support": "self.version",
        "symfony/html-sanitizer": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/service-contracts": "^3.6",
        "symfony/string": "^8.1",
        "symfony/ux-live-component": "^3.1",
        "symfony/ux-twig-component": "^3.1",
        "symfony/validator": "^8.1"
    },
    "suggest": {
        "league/commonmark": "Renders TextColumn::markdown() cells; without it the column throws when markdown() is set."
    },
    "autoload": {
        "psr-4": {
            "Sylament\\Tables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sylament\\Tables\\Tests\\": "tests/"
        }
    }
}
